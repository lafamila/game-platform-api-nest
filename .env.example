PORT=3035
HOST=0.0.0.0
# 'production' makes the session cookie Secure. Leave unset/blank for local http.
NODE_ENV=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/game_platform
# Local process: redis://localhost:6379
# Docker on teddy-infra: redis://teddy-redis:6379
REDIS_URL=redis://localhost:6379
PRESENCE_REDIS_PREFIX=game-platform:presence
PRESENCE_TTL_SECONDS=75

# Client app update prompts. Set minSupportedBuild above the shipped build to force update.
APP_IOS_LATEST_VERSION=1.0.0
APP_IOS_LATEST_BUILD=2
APP_IOS_MIN_SUPPORTED_BUILD=1
APP_IOS_UPDATE_URL=https://testflight.apple.com/join/replace_with_invite_code
APP_IOS_UPDATE_MESSAGE=
APP_ANDROID_LATEST_VERSION=1.0.0
APP_ANDROID_LATEST_BUILD=2
APP_ANDROID_MIN_SUPPORTED_BUILD=1
APP_ANDROID_UPDATE_URL=
APP_ANDROID_UPDATE_MESSAGE=
APP_MACOS_LATEST_VERSION=1.0.0
APP_MACOS_LATEST_BUILD=2
APP_MACOS_MIN_SUPPORTED_BUILD=1
APP_MACOS_UPDATE_URL=
APP_MACOS_UPDATE_MESSAGE=

AUTH_ISSUER_URL=http://localhost:3032
AUTH_API_BASE_URL=http://localhost:3032
AUTH_JWKS_URL=http://localhost:3032/oauth/jwks
AUTH_AUDIENCE=service:game-platform
AUTH_SERVICE_KEY=game-platform
AUTH_DENIED_PERMISSIONS=
AUTH_SERVICE_KEY_ID=replace_with_auth_service_credential_key_id
AUTH_SERVICE_SECRET=replace_with_auth_service_credential_secret

# OIDC BFF flow. The Flutter app must never receive this secret.
GAME_PLATFORM_OIDC_CLIENT_ID=game-platform-api
GAME_PLATFORM_OIDC_CLIENT_SECRET=replace_with_one_time_secret_from_auth_admin
GAME_PLATFORM_OIDC_REDIRECT_URI=http://localhost:3035/api/session/oidc/callback

# App session lifetime. expires_at = LEAST(created_at + ABSOLUTE, now + IDLE) and is
# slid forward on activity (throttled to once per 5 minutes).
GAME_PLATFORM_SESSION_IDLE_SECONDS=2592000            # idle timeout (30d)
GAME_PLATFORM_SESSION_ABSOLUTE_MAX_AGE_SECONDS=15552000 # hard cap from creation (180d)
# Legacy key: still drives the browser session-cookie max-age, and is used as the
# absolute-cap fallback only when GAME_PLATFORM_SESSION_ABSOLUTE_MAX_AGE_SECONDS is unset.
GAME_PLATFORM_SESSION_MAX_AGE_SECONDS=604800
# Keepalive job rotates a session's refresh token this long before it would expire so an
# app left closed for days keeps its chain (until auth ships per-client refresh TTL).
# Interval in seconds; set to 0 to disable the job.
GAME_PLATFORM_REFRESH_TOKEN_TTL_SECONDS=604800
GAME_PLATFORM_SESSION_KEEPALIVE_INTERVAL_SECONDS=3600
GAME_PLATFORM_SESSION_COOKIE_NAME=game_platform_session
GAME_PLATFORM_PUBLIC_BASE_URL=http://localhost:3035
GAME_PLATFORM_ALLOWED_RETURN_ORIGINS=http://localhost:3035
# Custom app callback schemes. Production should normally keep only gameplatform.
# Local dev scripts add gameplatform-dev for macOS debug callback isolation.
GAME_PLATFORM_ALLOWED_RETURN_SCHEMES=gameplatform

GAME_PLATFORM_ALLOWED_ORIGINS=http://localhost:3036,http://127.0.0.1:3036

# Sokoban 검증 맵 풀 생성 스위치. 'true' 일 때만 기동 시 맵을 생성/보충한다.
GENERATE_MAP=false

# 진행 중(playing/selecting) 상태로 이 일수 이상 방치된 세션을 abandoned 로 종료 처리 (0=off)
GAME_PLATFORM_SESSION_ABANDON_DAYS=7

# 턴 데드라인에 현재 턴 플레이어가 미접속일 때 부여하는 재접속 유예(초)
GAME_PLATFORM_DISCONNECT_GRACE_SECONDS=60

# 오델로/오목 hard AI 탐색 예산(ms). 호출 시점에 판독하므로 테스트가 소예산으로 오버라이드 가능.
# hard 는 이 예산 안에서 반복 심화로 최대 깊이를 탐색한다(최대 ~25초 대기 트레이드오프).
# easy/medium 은 기존 경로·기존 시간(별개 상수) 그대로이며 이 값의 영향을 받지 않는다.
OTHELLO_AI_BUDGET_MS=25000
GOMOKU_AI_BUDGET_MS=25000
# hard AI 워커 스레드 동시 실행 상한(초과분은 FIFO 대기). 코어 포화 방지.
GAME_AI_WORKER_POOL_SIZE=2
